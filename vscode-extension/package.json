{
  "name": "surd-vscode",
  "displayName": "surd — Live Repo & Claude Session Sync",
  "description": "Live multi-collaborator repo sync + shared Claude Code sessions",
  "version": "0.1.0",
  "publisher": "surd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surd/surd.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "surd.openPanel",
        "title": "Surd: Open Live Claude Panel"
      },
      {
        "command": "surd.linkWorkspace",
        "title": "Surd: Link Workspace to Server"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "surd.claudeFeed",
          "name": "Surd — Live Claude Feed"
        }
      ]
    },
    "configuration": {
      "title": "Surd",
      "properties": {
        "surd.server": {
          "type": "string",
          "default": "ws://localhost:4455",
          "description": "Surd server WebSocket URL"
        },
        "surd.token": {
          "type": "string",
          "default": "",
          "description": "Optional bearer token"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@surd/shared": "file:../shared",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/vscode": "^1.92.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
